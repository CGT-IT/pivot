<?xml version="1.0"?>
<ruleset name="Pivot">
    <description>
        Coding standard for the Pivot plugin.

        Deliberately partial: the codebase predates any standard, so enabling WordPress
        wholesale would report thousands of formatting issues and drown the ones that
        matter. The rules below are the ones that catch bugs and vulnerabilities —
        unescaped output, unprepared SQL, missing nonces, PHP version incompatibilities.
        Tighten this over time; formatting sniffs are the last thing to turn on.
    </description>

    <file>.</file>

    <exclude-pattern>/vendor/*</exclude-pattern>
    <exclude-pattern>/inc/external/*</exclude-pattern>
    <exclude-pattern>/js/*.min.js</exclude-pattern>
    <exclude-pattern>/languages/*</exclude-pattern>

    <arg name="extensions" value="php"/>
    <arg name="colors"/>
    <arg value="sp"/>

    <!-- Escaping, sanitisation, nonces, prepared statements. -->
    <rule ref="WordPress.Security"/>
    <rule ref="WordPress.DB.PreparedSQL"/>
    <rule ref="WordPress.DB.PreparedSQLPlaceholders"/>

    <!-- Things that break on a WordPress site. -->
    <rule ref="WordPress.WP.EnqueuedResources"/>
    <rule ref="WordPress.WP.GlobalVariablesOverride"/>
    <rule ref="WordPress.WP.DeprecatedFunctions"/>

    <!-- Syntax and functions removed in recent PHP versions. -->
    <config name="testVersion" value="7.4-"/>
    <rule ref="PHPCompatibilityWP"/>

    <!-- Templates are include()d with variables provided by the caller. -->
    <rule ref="WordPress.Security.EscapeOutput">
        <properties>
            <property name="customAutoEscapedFunctions" type="array">
                <element value="pivot_template"/>
                <element value="pivot_render_offers"/>
                <element value="pivot_render_offer_thumbnails"/>
                <element value="_show_warning"/>
                <element value="_show_admin_notice"/>
                <element value="_add_pagination"/>
            </property>
        </properties>
    </rule>
</ruleset>
